require "shellwords"

default_platform(:ios)

# Only the Unity path (beta_unity) of Birdie Smash `ios/fastlane/Fastfile`. No Flutter lane (beta): there is no Flutter in this repo.
# The Game Center / iCloud entitlement block is DELIBERATELY absent: the first release has no achievements or cloud saves; it is
# ported from Birdie when needed.

BUNDLE_ID = "com.keplerdrift.app"
APP_NAME = "Kepler Drift"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: false,
    in_house: false
  )
end

CHANGELOG_LIMIT = 4000

# whats_new.txt may carry an `=== UNITY ===` section (Birdie format); without headers the whole file is sent.
def whats_new_section(text, section)
  parts = text.split(/^===\s*([A-Z]+)\s*===\s*$/)
  return text if parts.length < 3
  sections = parts[1..].each_slice(2).to_h { |name, body| [name.strip, body.to_s.strip] }
  sections[section] || text
end

# Every build gets a different "What to Test" text: build no + short SHA + commit subject.
def testflight_changelog(build_number, section = "UNITY")
  notes = whats_new_section(File.read("../../store_listing/whats_new.txt", encoding: "UTF-8").scrub("").strip, section)
  identity = begin
    sha = sh("git rev-parse --short HEAD", log: false).to_s.force_encoding("UTF-8").scrub("").strip
    subject = sh("git log -1 --pretty=%s", log: false).to_s.force_encoding("UTF-8").scrub("").strip
    subject = "#{subject[0, 157]}..." if subject.length > 160
    ["Build #{build_number} · #{sha}", subject].reject(&:empty?).join("\n")
  rescue StandardError
    "Build #{build_number}"
  end
  full = "#{notes}\n\n———\n#{identity}"
  full.length > CHANGELOG_LIMIT ? full[0, CHANGELOG_LIMIT] : full
end

# Isolated, unlocked keychain + match (readonly) on the headless runner. Otherwise codesign asks for a password interactively
# and the job hangs (happened in Birdie/Harcliklarim).
def ci_signing_setup(api_key)
  keychain_path = File.expand_path("~/Library/Keychains/keplerdrift_ci-db")
  if is_ci
    create_keychain(
      name: "keplerdrift_ci",
      password: ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      require_create: false
    )
    existing = sh("security list-keychains -d user", log: false)
                 .lines.map { |l| l.strip.delete('"') }.reject(&:empty?)
    sh("security list-keychains -d user -s #{([keychain_path] + existing).uniq.shelljoin}", log: false)
    # `log: false` is REQUIRED: if the repo is public the password leaks into the log.
    sh("security unlock-keychain -p #{ENV['MATCH_PASSWORD'].to_s.shellescape} #{keychain_path.shellescape}", log: false)
  end

  match(
    type: "appstore",
    readonly: true,
    api_key: api_key,
    keychain_name: is_ci ? "keplerdrift_ci" : nil,
    keychain_password: is_ci ? ENV["MATCH_PASSWORD"] : nil
  )

  if is_ci
    identities = sh("security find-identity -v -p codesigning #{keychain_path.shellescape} || true", log: false)
    unless identities.include?("Apple Distribution")
      UI.user_error!("No 'Apple Distribution' identity in the keychain — MATCH_PASSWORD is wrong or the profile was never generated (was setup_match_certificates run?).")
    end
  end
end

# Highest TestFlight build number in this version and across the whole app + 1: the number can never go backwards.
def next_build_number_for(api_key, version)
  build_in_version = latest_testflight_build_number(
    app_identifier: BUNDLE_ID, api_key: api_key, version: version, initial_build_number: 0
  ) || 0
  build_any = latest_testflight_build_number(
    app_identifier: BUNDLE_ID, api_key: api_key, initial_build_number: 0
  ) || 0
  [build_in_version, build_any].max + 1
end

platform :ios do
  desc "First-time setup: generate the App Store profile for this bundle id with match (one-off, locally or in a manually triggered job)"
  lane :setup_match_certificates do
    api_key = asc_api_key
    match(type: "appstore", readonly: false, force_for_new_devices: false, api_key: api_key)
    UI.success("Match done — #{BUNDLE_ID} profile written")
  end

  # The Xcode project is generated on ubuntu by game-ci/unity-builder (CiBuild.iOS); this lane only signs, numbers, builds,
  # uploads. Why Info.plist is written directly (not increment_build_number): Unity's Info.plist carries CFBundleVersion as
  # literal text and ignores the CURRENT_PROJECT_VERSION agvtool writes; the number would silently stay old.
  desc "Sign, build and upload the Unity Xcode project (UNITY_XCODE_DIR) to TestFlight"
  lane :beta_unity do
    dir = ENV["UNITY_XCODE_DIR"].to_s
    UI.user_error!("UNITY_XCODE_DIR missing or does not contain Unity-iPhone.xcodeproj: #{dir}") unless File.directory?(File.join(dir, "Unity-iPhone.xcodeproj"))
    xcodeproj = File.join(dir, "Unity-iPhone.xcodeproj")
    plist = File.join(dir, "Info.plist")
    profile = "match AppStore #{BUNDLE_ID}"

    api_key = asc_api_key
    ci_signing_setup(api_key)

    # The app target is signed manually with the match profile. UnityFramework is a framework: it takes no profile (given one,
    # Xcode says "does not support provisioning profiles"), only identity + team.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: profile,
      targets: ["Unity-iPhone"],
      build_configurations: ["Release"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      targets: ["UnityFramework"],
      build_configurations: ["Release"]
    )

    # Version name from Unity (CiBuild.Version -> Info.plist), number from the TestFlight sequence.
    version = get_info_plist_value(path: plist, key: "CFBundleShortVersionString").to_s
    UI.user_error!("No CFBundleShortVersionString in Info.plist") if version.empty?
    next_build_number = next_build_number_for(api_key, version)
    UI.message("Unity · version #{version}, build #{next_build_number}")
    set_info_plist_value(path: plist, key: "CFBundleVersion", value: next_build_number.to_s)
    # Unity writes it too (CiBuild.PlistKey); a second time here, because without the key the build waits in "Missing Compliance".
    set_info_plist_value(path: plist, key: "ITSAppUsesNonExemptEncryption", value: false)
    set_info_plist_value(path: plist, key: "CFBundleDisplayName", value: APP_NAME)
    set_info_plist_value(path: plist, key: "UISupportedInterfaceOrientations", value: ["UIInterfaceOrientationPortrait"])
    set_info_plist_value(path: plist, key: "UISupportedInterfaceOrientations~ipad", value: ["UIInterfaceOrientationPortrait"])
    set_info_plist_value(path: plist, key: "UIRequiresFullScreen", value: true)

    build_app(
      project: xcodeproj,
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      clean: false,
      output_directory: "./build",
      output_name: "keplerdrift.ipa",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: testflight_changelog(next_build_number, "UNITY")
    )
    sh("echo TF_BUILD_NUMBER=#{next_build_number} >> $GITHUB_ENV") if ENV["GITHUB_ENV"]
    UI.success("Uploaded to TestFlight (Unity): #{version} (#{next_build_number})")
  end
end
